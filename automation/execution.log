import re, os, sys

path = "creds.cfg" if os.path.exists("creds.cfg") else ("cred.cfg" if os.path.exists("cred.cfg") else None)
if not path:
    print("ERROR: Neither creds.cfg nor cred.cfg exists!")
    sys.exit(1)

os.system(f"cp {path} {path}.bak")

with open(path, "r") as f:
    lines = f.readlines()

old_keys = set()
in_template_block = False

for line in lines:
    stripped = line.strip()
    if stripped.startswith("#"):
        continue  # Ignore commented-out lines
    if "Template_files" in line and "{" in line:
        in_template_block = True
    if in_template_block:
        m = re.search(r"\"([^\"]+)\"\s*:", stripped)
        if m:
            old_keys.add(m.group(1))
        if "}" in line:
            in_template_block = False

# Fallback: Check NSD_Segregation block if not found in Template_files
if not old_keys:
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("#"):
            continue
        if "NSD_Segregation" in line:
            m = re.search(r"\[\s*\"([^\"]+)\"\s*\]", stripped)
            if m:
                old_keys.add(m.group(1))

if not old_keys:
    print("ERROR: No active uncommented node key found in creds.cfg!")
    sys.exit(1)

text = "".join(lines)
target_val = "epdg_dp_node11"
for k in old_keys:
    text = text.replace(f"\"{k}\"", f"\"{target_val}\"")

with open(path, "w") as f:
    f.write(text)

print(f"REPLACED_KEYS:{list(old_keys)}->{target_val}")
'[0m
